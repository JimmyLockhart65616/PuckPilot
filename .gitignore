.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Secrets and local state.
# .env.* as well as .env: a stray .env.local holds the same credentials.
.env
.env.*
!.env.example
secrets/
# Token caches, wherever Settings.token_path is pointed. Naming only
# secrets/oauth2.json would protect the default and nothing else.
oauth2.json
token.json
*.token.json

# Local data. `data/` is ignored wholesale and the tracked exceptions are named,
# so a new subdirectory of recordings is private by default rather than by
# someone remembering to add a rule. Draft-room recordings in particular hold
# live session cookies and personal league data.
data/

# League configs are PRIVATE: they carry a live Yahoo league id, the league
# name, and named keeper rosters for every team in it. Ignore the directory and
# allow only the documented template back in. Listing one filename instead
# protected exactly that filename - and left `leagues/default.toml`, which is
# the built-in default path in config.py, publishable.
leagues/*
!leagues/example.toml

# Local, unpublished helpers - research tools, not part of the product.
# Directory-wide for the same reason as data/ and leagues/: private by default,
# not by someone remembering to add a rule for each new file.
src/puckpilot/local/

# Internal working notes - not for the public repo.
docs/
CLAUDE.md

# Tooling output.
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.log

# Playwright artefacts: traces and videos of a logged-in Yahoo session.
playwright-report/
test-results/
trace.zip

# Editors.
.idea/
.vscode/
